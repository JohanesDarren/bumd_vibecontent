DATABASE_URL=postgresql://vibecontent:vibecontent_dev@127.0.0.1:5435/vibecontent
API_PORT=3005
# Idle timeout (minutes) before a session is invalidated. Absolute cap is 7 days.
SESSION_IDLE_MINUTES=30
VITE_API_URL=http://127.0.0.1:3005
# Existing RAG engine: retrieval/generation. Do not replace with KMS credentials.
RAG_API_URL=https://rag.aiones.app/
RAG_API_KEY=replace-with-server-only-key
RAG_TIMEOUT_MS=60000
# Server-only. Account token needs Workers AI permission. Never prefix with VITE_.
# Keep account on Workers Free for a hard free-tier quota; no automatic upgrades.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional second Workers AI account for fallback after first-account failure/quota.
# It has its own independent Workers AI quota. Keep both values server-only.
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_TOKEN_2=
