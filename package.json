{
  "name": "bumd_vibecontent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite",
    "server": "tsx watch server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "db:clear": "tsx server/clear.ts",
    "db:reset": "tsx server/reset.ts",
    "test:db": "set NODE_ENV=test&& set DATABASE_URL=postgresql://vibecontent:vibecontent_dev@127.0.0.1:5435/vibecontent_test&& tsx --test --test-concurrency=1 server/empty.integration.test.ts server/database.integration.test.ts server/crud.integration.test.ts server/endpoints.integration.test.ts server/auth.integration.test.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test src/services/*.test.ts server/knowledgeAccess.test.ts server/security.test.ts",
    "test:visual": "tsx --test server/visual.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-spinners": "^0.17.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
